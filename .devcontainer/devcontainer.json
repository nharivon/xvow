{
  "name": "Flutter Web",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/flutter:latest": {
      "version": "stable",
      "androidSdk": false
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "flutter config --enable-web && flutter doctor"
}